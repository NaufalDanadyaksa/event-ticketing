datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  USER
}

enum RegistrationStatus {
  WAITING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}

enum AttendanceStatus {
  ABSENT
  ATTENDED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  name               String
  phone              String?
  role               Role           @default(USER)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  registrations      Registration[]
  eventsCreated      Event[]        @relation("AdminEvents")
  checkInsPerformed  Registration[] @relation("StaffCheckIns")

  @@map("users")
}

model Event {
  id                   String         @id @default(uuid())
  title                String
  slug                 String         @unique
  description          String         @db.Text
  bannerUrl            String?

  isPaid               Boolean        @default(false)
  price                Decimal        @default(0.00) @db.Decimal(10, 2)
  bankName             String?
  bankAccountNumber    String?
  bankAccountHolder    String?

  maxParticipants      Int            @default(0)
  registrationDeadline DateTime
  eventStartDate       DateTime
  eventEndDate         DateTime
  location             String

  attendanceEnabled    Boolean        @default(true)
  attendanceSecret     String

  isPublished          Boolean        @default(false)

  createdById          String
  createdBy            User           @relation("AdminEvents", fields: [createdById], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  registrations        Registration[]

  @@index([slug])
  @@index([createdById])
  @@map("events")
}

model Registration {
  id                 String             @id @default(uuid())
  ticketCode         String             @unique
  magicToken         String             @unique @default(uuid())

  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  name               String
  email              String
  phone              String

  status             RegistrationStatus @default(CONFIRMED)
  paymentProofUrl    String?
  rejectionReason    String?
  approvedAt         DateTime?
  approvedByAdminId  String?

  checkInStatus      CheckInStatus      @default(NOT_CHECKED_IN)
  checkedInAt        DateTime?
  checkedInByStaffId String?
  checkedInByStaff   User?              @relation("StaffCheckIns", fields: [checkedInByStaffId], references: [id])

  attendanceStatus   AttendanceStatus   @default(ABSENT)
  attendedAt         DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([ticketCode])
  @@index([magicToken])
  @@map("registrations")
}
